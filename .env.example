# KnowledgeAssist Environment Configuration
# Copy to .env and replace placeholder values before running in production.

# Gemini AI API Key (Server-side only)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_CHAT_MODEL="gemini-4-hydrogen"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"

# Application URL
APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV="development"

# JWT & Session Security (Generate strong 64+ char secrets in production)
JWT_ACCESS_SECRET="change-me-in-production-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-in-production-refresh-secret-min-32-chars"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# RAG & Chunking Configuration
RAG_CHUNK_SIZE_TOKENS=850
RAG_CHUNK_OVERLAP_TOKENS=120
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.18
MAX_UPLOAD_MB=50

# Spring Boot / PostgreSQL / Redis / RabbitMQ (for Docker Compose & Backend deployment)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=knowledgeassist
POSTGRES_USER=knowledgeassist
POSTGRES_PASSWORD=change-me-postgres-password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=knowledgeassist
RABBITMQ_PASSWORD=change-me-rabbitmq-password

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=change-me-llm-api-key
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
