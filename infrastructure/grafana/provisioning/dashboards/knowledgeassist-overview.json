{
  "title": "KnowledgeAssist Enterprise RAG Telemetry",
  "uid": "knowledgeassist-rag-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total RAG Queries",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "knowledgeassist_queries_total", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Abstained Queries",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "knowledgeassist_queries_abstained_total", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Indexed Documents",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "knowledgeassist_documents_indexed_total", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Average Response Latency (ms)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "knowledgeassist_query_latency_ms_avg", "refId": "A" }]
    }
  ]
}
